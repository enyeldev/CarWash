generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- ENUMS ---

enum UserPlan {
  FREE
  BASIC
  PRO
  CUSTOM
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  TRAILING
  INCOMPLETE
}

enum MemberRole {
  OWNER // Dueño: Acceso total y gestión de suscripción
  ADMIN // Gerente: Gestión de empleados y configuración
  CASHIER // Cajero: Ventas, tickets y reportes diarios
  VIEWER // Auditor: Solo lectura de reportes
}

enum ProductStatus {
  AVAILABLE
  WARNING
  OUT_OF_STOCK
  DELETED
}

enum ItemType {
  PRODUCT
  SERVICE
}

enum InventoryAction {
  ADD
  REMOVE
  ADJUSTMENT
}

// --- NÚCLEO DE AUTENTICACIÓN (Better Auth) ---

model User {
  id            String  @id
  name          String
  email         String  @unique
  emailVerified Boolean @default(false)
  image         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions    Session[]
  accounts    Account[]
  memberships Member[] // Un usuario puede ser miembro de múltiples CarWashes

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// --- MULTI-TENANCY (Estructura de Negocio) ---

model Company {
  id          String  @id @default(uuid())
  name        String
  phone       String
  description String?

  // Suscripción ligada a la empresa
  plan                 UserPlan           @default(FREE)
  trialEndsAt          DateTime?          @default(dbgenerated("now() + interval '14 days'"))
  subscriptionStatus   SubscriptionStatus @default(TRAILING)
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  members      Member[]
  invitations  Invitation[]
  products     Product[]
  services     Service[]
  items        Item[]
  sales        Sale[]
  washMen      WashMan[]
  tickets      Ticket[]
  cashSessions CashSession[]

  @@map("company")
}

model Member {
  id       String     @id @default(uuid())
  role     MemberRole @default(CASHIER)
  isActive Boolean    @default(true)

  companyId String
  userId    String

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Trazabilidad: Quién hizo qué
  sales          Sale[]
  inventoryLogs  InventoryLog[]
  openedSessions CashSession[]  @relation("Opener")
  closedSessions CashSession[]  @relation("Closer")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, userId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id        String     @id @default(uuid())
  email     String? // Opcional para links manuales
  role      MemberRole @default(CASHIER)
  token     String     @unique
  companyId String
  expiresAt DateTime
  accepted  Boolean    @default(false)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("invitation")
}

// --- INVENTARIO Y SERVICIOS ---

model Item {
  id        String    @id @default(uuid())
  companyId String
  type      ItemType
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  company   Company    @relation(fields: [companyId], references: [id])
  product   Product?
  service   Service?
  saleItems SaleItem[]

  @@index([companyId, type])
  @@map("item")
}

model Product {
  id          String        @id @default(uuid())
  name        String
  description String?
  status      ProductStatus @default(AVAILABLE)
  image       String?

  companyId String
  itemId    String @unique

  company Company @relation(fields: [companyId], references: [id])
  item    Item    @relation(fields: [itemId], references: [id])

  stock         ProductStock?
  inventoryLogs InventoryLog[]

  @@index([companyId])
  @@map("product")
}

model ProductStock {
  id        String  @id @default(uuid())
  quantity  Int     @default(0)
  price     Decimal @db.Decimal(10, 2)
  productId String  @unique

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_stock")
}

model InventoryLog {
  id        String          @id @default(uuid())
  quantity  Int
  action    InventoryAction
  reason    String?
  createdAt DateTime        @default(now())

  productId String
  memberId  String // Quién movió el stock

  product Product @relation(fields: [productId], references: [id])
  member  Member  @relation(fields: [memberId], references: [id])

  @@map("inventory_log")
}

model Service {
  id          String  @id @default(uuid())
  name        String
  description String?
  price       Decimal @db.Decimal(10, 2)

  companyId String
  itemId    String @unique

  company Company @relation(fields: [companyId], references: [id])
  item    Item    @relation(fields: [itemId], references: [id])

  ticketServices TicketService[]

  @@index([companyId])
  @@map("service")
}

// --- OPERACIONES DE LAVADO ---

model WashMan {
  id        String  @id @default(uuid())
  name      String
  document  String?
  phone     String?
  isActive  Boolean @default(true)
  companyId String

  company Company  @relation(fields: [companyId], references: [id])
  tickets Ticket[]

  @@map("wash_man")
}

model Ticket {
  id             String  @id @default(uuid())
  carDescription String
  carPlate       String
  ownerName      String?
  ownerPhone     String?

  status     String    @default("PENDING") // PENDING, WASHING, READY, DELIVERED
  arrivedAt  DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?

  companyId String
  washManId String

  company  Company         @relation(fields: [companyId], references: [id])
  washMan  WashMan         @relation(fields: [washManId], references: [id])
  services TicketService[]

  @@index([companyId, arrivedAt])
  @@map("ticket")
}

model TicketService {
  ticketId  String
  serviceId String

  ticket  Ticket  @relation(fields: [ticketId], references: [id])
  service Service @relation(fields: [serviceId], references: [id])

  @@id([ticketId, serviceId])
  @@map("ticket_service")
}

// --- VENTAS Y CAJA ---

model CashSession {
  id            String    @id @default(uuid())
  openingAmount Decimal   @db.Decimal(10, 2)
  closingAmount Decimal?  @db.Decimal(10, 2)
  openedAt      DateTime  @default(now())
  closedAt      DateTime?

  companyId  String
  openedById String
  closedById String?

  company  Company @relation(fields: [companyId], references: [id])
  openedBy Member  @relation("Opener", fields: [openedById], references: [id])
  closedBy Member? @relation("Closer", fields: [closedById], references: [id])

  @@map("cash_session")
}

model Sale {
  id       String   @id @default(uuid())
  total    Decimal  @db.Decimal(10, 2)
  paidWith String // CASH, CARD, TRANSFER
  soldAt   DateTime @default(now())

  companyId String
  memberId  String // El empleado que hizo la venta

  company   Company    @relation(fields: [companyId], references: [id])
  member    Member     @relation(fields: [memberId], references: [id])
  saleItems SaleItem[]

  @@index([companyId, soldAt])
  @@map("sale")
}

model SaleItem {
  id       String  @id @default(uuid())
  quantity Int
  price    Decimal @db.Decimal(10, 2)

  saleId String
  itemId String

  sale Sale @relation(fields: [saleId], references: [id])
  item Item @relation(fields: [itemId], references: [id])

  @@map("sale_item")
}
